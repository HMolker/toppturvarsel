# ---- server ----
# Local time zone: quiet hours and dates follow it.
TZ=Europe/Stockholm
# Port on the Pi (what you open in the browser and forward in the router).
HOST_PORT=8080
# Which version the Pi runs: "latest" follows the newest, or pin a tag
# (see CHANGELOG.md / `git tag -l`), e.g. v4.0.1. Then:
#   docker compose pull && docker compose up -d
FJALLSKRED_VERSION=latest
# Port inside the container; leave it.
PORT=8080
# Comma-separated. Leave blank to bind all interfaces.
HOST=0.0.0.0

# ---- refresh ----
# How often to pull upstream data, in minutes. Upstream bulletins update
# roughly once a day, so anything under 60 is wasted load on NVE/SMHI.
REFRESH_MINUTES=180
# Skip refreshing entirely outside the forecast season (1 Nov - 15 Jun).
SEASON_ONLY=true
# Minimum minutes between refreshes forced with the page's "Refresh now"
# button (the page is public, so strangers can press it too).
REFRESH_COOLDOWN_MINUTES=10

# ---- alerts ----
# Fire when new snow over 48h reaches this many cm.
ALERT_THRESHOLD_CM=30
# Comma-separated region ids to watch, or "all".
ALERT_REGIONS=all
# Countries to notify about, e.g. NO,SE, or "all". The country buttons on
# the page only change what you see; this decides what you are sent.
ALERT_COUNTRIES=all
# Quiet hours (local time, 24h). Alerts found in this window are held
# until the window ends, so a 03:00 refresh does not wake you.
ALERT_QUIET_FROM=22
ALERT_QUIET_TO=6

# ---- email (optional) ----
# resend | smtp | none
MAIL_PROVIDER=none
# Where alerts go (comma-separated for several).
MAIL_TO=
# Who they come from. With smtp this must be the mailbox you log in as;
# with resend, an address on a domain you verified there.
MAIL_FROM=toppturvarsel@example.com
# for MAIL_PROVIDER=resend
RESEND_API_KEY=
# for MAIL_PROVIDER=smtp: your own mailbox, as one address line.
#   Gmail:   smtps://you%40gmail.com:APPPASSWORD@smtp.gmail.com:465
#   Outlook: smtp://you%40outlook.com:PASSWORD@smtp-mail.outlook.com:587
# Gmail needs an app password (Google Account > Security > 2-Step
# Verification > App passwords), not your normal password, and the 16
# letters are written without spaces. Encode @ in the user name as %40,
# and any of : / @ ? # in the password likewise (: is %3A, / is %2F).
SMTP_URL=

# ---- photos (optional) ----
# Openly licensed photos near a summit come from Wikimedia Commons, which is
# thin for the smaller peaks. With a free Flickr key (flickr.com/services/apps
# /create/apply) the tool also shows Creative-Commons photos from Flickr,
# credited and linked back. Without a key, Flickr is simply not asked.
FLICKR_API_KEY=

# ---- observations (optional, experimental) ----
# Raw Regobs observation counts. OFF by default: the Regobs search API is
# POST-only and its request shape could not be verified against the live
# service when this was written, so an enabled-but-wrong integration would
# report "0 observations" for "we could not read it". With this off, the UI
# shows the forecaster's own observation summary from Varsom instead, which
# is verified. If you turn it on, check /api/health - it reports whether the
# counts are actually coming back.
REGOBS_ENABLED=false

# ---- routes, elevation, forecast ----
# Derive tour routes from OpenStreetMap in the background after start-up,
# one tour every few seconds. Set false to only derive on first click.
TRACKS_WARMUP=true

# Night scan: fetch and store every ski resort's map (lifts, runs, facts) and
# snow history between these hours (Norwegian time), refreshing maps older
# than RESORT_MAP_MAX_AGE_DAYS. Clicks in the app always go first.
NIGHT_SCAN=on
NIGHT_SCAN_HOURS=1-5
NIGHT_SCAN_GAP_S=60
RESORT_MAP_MAX_AGE_DAYS=30
# How far out to look for a resort's lifts (metres). Lifts linked end to end
# are followed beyond this, so big linked areas come out whole.
RESORT_RADIUS_M=7000
# Alternative Overpass instance if the main one is busy.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# Elevation and photo services; the defaults are the public ones.
# KARTVERKET_ELEVATION_URL=https://ws.geonorge.no/hoydedata/v1/punkt
# ELEVATION_URL=https://api.open-meteo.com/v1/elevation
# COMMONS_API_URL=https://commons.wikimedia.org/w/api.php

# ---- ski resorts layer ----
# Norway live from Fnugg (hourly in season), Sweden from OpenStreetMap (monthly).
RESORTS_ENABLED=true
# FNUGG_URL=https://api.fnugg.no/search

# ---- ntfy push (optional) ----
# Pick a long, unguessable topic - anyone who knows it can read your alerts.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh
NTFY_TOKEN=
