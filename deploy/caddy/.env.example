# The DuckDNS name (duckdns.org) that points at the Pi. Not the router's
# tplinkdns.com name: TP-Link's name servers answer "no such name" to IPv6
# lookups, and Let's Encrypt then refuses the certificate (see INSTALL.md, 8c).
SITE_HOST=tomtarochtroll.duckdns.org
# For the certificate authority: notices about expiring certificates.
ACME_EMAIL=
# Where the apps listen on the Pi (the port you open them on today).
FJALLSKRED_PORT=8095
# Required: Caddy will not start with this empty.
MOLKER_HEMMA_PORT=
